{
    "id": "jrCentral",
    "nameJa": "JR東海",
    "nameEn": "JR Central",
    "colors": {
        "ring": "lineColor",
        "prefixLetter": "#FFFFFF",
        "plate": "lineColor",
        "numberLetter": "#000000",
        "core": "#FFFFFF",
        "letter": "#FFFFFF"
    },
    "line": {
        "layers": [
            {
                "shape": "roundedRect",
                "radiusRatio": 0.12,
                "fill": "$plate"
            }
        ],
        "color": "$letter",
        "size": 18.5,
        "minimumScaleFactor": 0.5,
        "kerning": true,
        "family": "Hind-Bold",
        "sizeMulti": 18.5,
        "insetH": 4.5,
        "nudgeBase": 15,
        "nudgeBaseMulti": 15
    },
    "station": {
        "spacing": 0,
        "rows": [
            {
                "kind": "prefix",
                "sizeRatio": 0.58,
                "family": "Hind-Bold",
                "color": "$prefixLetter",
                "background": "$plate",
                "heightRatio": 0.42,
                "offsetYRatio": 0.0442,
                "fullWidth": true
            },
            {
                "kind": "number",
                "sizeRatio": 0.82,
                "family": "Hind-Bold",
                "color": "$numberLetter",
                "background": "$core",
                "maxHeightRatio": 0.5,
                "offsetYRatio": 0.010400000000000001,
                "fullWidth": true
            }
        ],
        "clip": {
            "shape": "roundedRect",
            "radiusRatio": 0.12,
            "continuous": true
        },
        "overlays": [
            {
                "shape": "roundedRect",
                "radiusRatio": 0.12,
                "continuous": true,
                "stroke": "$ring",
                "lineWidth": 2.0
            }
        ],
        "minimumScaleFactor": 0.6
    }
}