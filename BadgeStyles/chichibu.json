{
    "id": "chichibu",
    "nameJa": "秩父鉄道",
    "nameEn": "Chichibu Railway",
    "colors": {
        "letter": "#FFFFFF",
        "plate": "#0070C0"
    },
    "line": {
        "layers": [
            {
                "shape": "roundedRect",
                "radiusRatio": 0.24,
                "continuous": true,
                "fill": "$plate"
            }
        ],
        "color": "$letter",
        "size": 18.5,
        "minimumScaleFactor": 0.5,
        "kerning": true,
        "family": "Hind-Bold",
        "sizeMulti": 18.5,
        "insetH": 4.5,
        "nudgeBase": 15,
        "nudgeBaseMulti": 15
    },
    "station": {
        "spacing": 1,
        "rows": [
            {
                "kind": "prefix",
                "sizeRatio": 0.52,
                "family": "Hind-Bold",
                "heightRatio": 0.39,
                "offsetYRatio": 0.1248,
                "fullWidth": true
            },
            {
                "kind": "number",
                "sizeRatio": 0.7,
                "family": "Hind-Bold",
                "heightRatio": 0.525,
                "offsetYRatio": -0.042,
                "fullWidth": true
            }
        ],
        "solo": {
            "kind": "number",
            "sizeRatio": 0.66,
            "family": "Hind-Bold"
        },
        "layers": [
            {
                "shape": "roundedRect",
                "radiusRatio": 0.24,
                "continuous": true,
                "fill": "$plate"
            }
        ],
        "color": "$letter",
        "minimumScaleFactor": 0.6
    }
}
