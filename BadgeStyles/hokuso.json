{
    "id": "hokuso",
    "nameJa": "北総鉄道",
    "nameEn": "Hokuso Railway",
    "colors": {
        "letter": "lineColor",
        "core": "#FFFFFF",
        "ring": "lineColor"
    },
    "line": {
        "layers": [
            {
                "shape": "circle",
                "fill": "$core"
            }
        ],
        "overlays": [
            {
                "shape": "circle",
                "stroke": "$ring",
                "lineWidthRatio": 0.13125
            }
        ],
        "color": "$letter",
        "size": 14.5,
        "minimumScaleFactor": 0.5,
        "kerning": true,
        "sizeMulti": 14.5,
        "weight": "bold",
        "width": "standard",
        "insetH": 4.5,
        "nudgeBaseMulti": 0
    },
    "station": {
        "spacing": 0,
        "rows": [
            {
                "kind": "prefix",
                "sizeRatio": 0.3,
                "weight": "bold",
                "width": "standard",
                "heightRatio": 0.34,
                "offsetY": 0.6
            },
            {
                "kind": "number",
                "sizeRatio": 0.54,
                "family": "Helvetica",
                "heightRatio": 0.46,
                "offsetY": -0.6
            }
        ],
        "layers": [
            {
                "shape": "rect",
                "fill": "$core"
            }
        ],
        "clip": {
            "shape": "circle"
        },
        "overlays": [
            {
                "shape": "circle",
                "stroke": "$ring",
                "lineWidthRatio": 0.09
            }
        ],
        "color": "$letter",
        "minimumScaleFactor": 0.6
    }
}
